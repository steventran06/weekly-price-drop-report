{
  "name": "weekly-price-drop-report",
  "version": "1.0.0",
  "description": "Weekly RMLS Price Drop Report Generator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/weeklyPriceDrops/index.ts",
    "weekly": "tsx src/weeklyPriceDrops/index.ts",
    "market-stats": "tsx src/marketStats/index.ts",
    "monthly-buyer-report": "tsx src/monthlyBuyerReport/index.ts",
    "auth:export": "tsx src/exportAuth.ts",
    "inspect": "tsx src/inspect.ts",
    "parse": "tsx src/parse.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "events": "tsx src/events/index.ts",
    "new-construction": "tsx src/newConstruction/index.ts",
    "new-construction:dry-run": "NEW_CONSTRUCTION_DRY_RUN=true tsx src/newConstruction/index.ts",
    "reddit-alerts": "tsx src/redditAlerts/index.ts",
    "reddit-alerts:dry-run": "REDDIT_ALERTS_DRY_RUN=true tsx src/redditAlerts/index.ts",
    "reddit-alerts:test": "tsx src/redditAlerts/testNotification.ts",
    "reddit-alerts:api-test": "tsx src/redditAlerts/testRedditApi.ts",
    "reddit-alerts:filter-test": "tsx src/redditAlerts/testFilters.ts",
    "instagram:preview": "tsx src/social/instagram/preview.ts",
    "instagram:publish": "tsx src/social/instagram/publishExisting.ts",
    "price-drops:carousel-preview": "tsx src/social/instagram/priceDropPreview.ts",
    "mortgage-rates": "tsx src/mortgageRates/index.ts",
    "mortgage-rates:preview": "MORTGAGE_RATES_DRY_RUN=true tsx src/mortgageRates/index.ts"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^2.1.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.1",
    "googleapis": "^105.0.0",
    "openai": "^7.4.0",
    "pdfjs-dist": "^6.2.108",
    "youtubei.js": "^18.0.0",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
